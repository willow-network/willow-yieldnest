# Dashboard runtime config. Copy to .env.local (gitignored) and fill in.
#
# In dev, each VITE_ var falls back to a Vite proxy (see vite.config.ts), so you
# can leave them empty and run against a local Willow stack. For your own
# deployment, set them to your own endpoints — do NOT rely on .env.production,
# which points at Willow's infrastructure.

# Willow validator REST API (serves /subgroves). Dev fallback: /willow-api proxy -> :3031
VITE_WILLOW_API=

# Willow indexer GraphQL endpoint (historical queries + proofs). Dev fallback: /indexer-gql proxy -> :3051
VITE_INDEXER_GQL=

# Ethereum RPC for live totalAssets() + chain-tip calls. Dev fallback: /eth-rpc proxy
VITE_ETH_RPC=

# Dev-only key for the /eth-rpc proxy (build/proxy-time only, never shipped to the client).
ALCHEMY_ETH_KEY=your_eth_rpc_key_here
