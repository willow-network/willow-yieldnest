# Production endpoints, inlined by Vite at build time. These point at WILLOW's
# infrastructure — if you fork this dashboard, override every value (here or in
# your host's build env) so your build talks to your own node and indexer.
VITE_WILLOW_API=https://api.willow.tech
VITE_INDEXER_GQL=https://indexer.willow.tech
VITE_ETH_RPC=https://ethereum.publicnode.com
